{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causalops:diagnostic-finding:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "diagnostic-finding-v1"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "context": {
      "$ref": "urn:causalops:diagnostics-common:v1#/$defs/Context"
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PD-(?:0[1-9]|1[0-4])$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pack": {
          "const": "hillstrom-diagnostics-v1"
        },
        "check_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "version",
        "pack",
        "check_method"
      ],
      "additionalProperties": false
    },
    "diagnostic_type": {
      "enum": [
        "binding",
        "design",
        "sample",
        "metric",
        "inference",
        "interpretation",
        "execution"
      ]
    },
    "applicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "unknown"
      ]
    },
    "check_performed": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "verified",
        "issue",
        "unknown",
        "not_applicable",
        "not_checked"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "observed": {},
        "expected": {},
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "missing_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "observed",
        "expected",
        "reason_code",
        "missing_items"
      ],
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:causalops:diagnostics-common:v1#/$defs/EvidenceRef"
      },
      "maxItems": 12
    },
    "impact": {
      "type": "object",
      "properties": {
        "claim_effect": {
          "enum": [
            "unchanged",
            "conditional_causal_only",
            "descriptive_only",
            "hide_integrated_estimate",
            "show_limitation"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "execution_authority": {
          "const": "original_service_only"
        }
      },
      "required": [
        "claim_effect",
        "explanation",
        "execution_authority"
      ],
      "additionalProperties": false
    },
    "severity": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "critical",
            "major",
            "moderate",
            "information"
          ]
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "level",
        "policy_id",
        "reason_code"
      ],
      "additionalProperties": false
    },
    "human_confirmation_required": {
      "type": "boolean"
    },
    "eligible_action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 3,
      "uniqueItems": true
    },
    "generated_at": {
      "$ref": "urn:causalops:diagnostics-common:v1#/$defs/Timestamp"
    },
    "source": {
      "type": "object",
      "properties": {
        "mechanism": {
          "enum": [
            "deterministic_rule",
            "engine_adapter",
            "declaration_record_check"
          ]
        },
        "origin": {
          "enum": [
            "program_fact",
            "human_declaration",
            "mixed"
          ]
        },
        "generator_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "mechanism",
        "origin",
        "generator_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "assessment_id",
    "context",
    "rule",
    "diagnostic_type",
    "applicability",
    "check_performed",
    "status",
    "result",
    "evidence_refs",
    "impact",
    "severity",
    "human_confirmation_required",
    "eligible_action_ids",
    "generated_at",
    "source"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "verified"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "check_performed": {
            "const": true
          },
          "evidence_refs": {
            "minItems": 1,
            "contains": {
              "properties": {
                "availability": {
                  "const": "valid"
                }
              },
              "required": [
                "availability"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "issue",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "check_performed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "missing_items": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not_checked",
              "not_applicable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "check_performed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not_applicable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "applicability": {
            "const": "not_applicable"
          }
        }
      }
    }
  ]
}
