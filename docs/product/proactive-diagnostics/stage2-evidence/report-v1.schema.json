          "type": "boolean"
        },
        "status": {
          "const": "needs_information",
          "default": "needs_information",
          "title": "Status",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "source": {
          "const": "deterministic_rule_mapping",
          "default": "deterministic_rule_mapping",
          "title": "Source",
          "type": "string"
        },
        "execution_authorized": {
          "const": false,
          "default": false,
          "title": "Execution Authorized",
          "type": "boolean"
        }
