        "objective",
        "scope",
        "design_observations",
        "limitations"
      ],
      "title": "ResearchResults",
      "type": "object"
    },
    "ResearchSuggestion": {
      "additionalProperties": false,
      "properties": {
        "suggestion_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suggestion Id",
          "type": "string"
        },
        "diagnostic_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Diagnostic Id",
          "type": "string"
        },
        "assessment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assessment Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "template_version": {
          "const": "six-rule-suggestions-v1",
          "default": "six-rule-suggestions-v1",
