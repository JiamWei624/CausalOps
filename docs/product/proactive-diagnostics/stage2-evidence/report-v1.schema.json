        "suggestion_id",
        "diagnostic_id",
        "assessment_id",
        "rule_id",
        "rule_version",
        "context_fingerprint",
        "related_refs",
        "action",
        "reason_code",
        "reason",
        "required_evidence",
        "limitations"
      ],
      "title": "ResearchSuggestion",
      "type": "object"
    },
