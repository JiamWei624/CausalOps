        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "required_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Required Evidence",
          "type": "array"
        },
        "new_scope": {
          "default": "requires_separate_request",
