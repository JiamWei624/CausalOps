  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "diagnostic-report-v1",
      "default": "diagnostic-report-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
