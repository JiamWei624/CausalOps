        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "sha": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha"
      ],
      "title": "PlanReference",
      "type": "object"
    },
    "ResearchResults": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "partial",
            "available",
            "restricted"
          ],
          "title": "Status",
          "type": "string"
