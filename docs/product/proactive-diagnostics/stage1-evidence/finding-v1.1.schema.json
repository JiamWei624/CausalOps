{
  "$defs": {
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "observed": {
          "additionalProperties": true,
          "title": "Observed",
          "type": "object"
        },
        "expected": {
          "additionalProperties": true,
          "title": "Expected",
          "type": "object"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "missing_items": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Items",
          "type": "array"
        },
        "required_work": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Work",
          "type": "array"
        }
      },
      "required": [
        "observed",
        "expected",
        "reason_code"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "ContractReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "sha": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha",
          "type": "string"
        },
        "data_sha": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Data Sha",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha",
        "data_sha"
      ],
      "title": "ContractReference",
      "type": "object"
    },
    "DataReference": {
      "additionalProperties": false,
      "properties": {
        "upload_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Upload Id",
          "type": "string"
        },
        "frame_sha": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Frame Sha",
          "type": "string"
        }
      },
      "required": [
        "upload_id",
        "frame_sha"
      ],
      "title": "DataReference",
      "type": "object"
    },
    "DiagnosticContext": {
      "additionalProperties": false,
      "properties": {
        "task_ref": {
          "$ref": "#/$defs/TaskReference"
        },
        "plan_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "no_plan_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "No Plan Reason"
        },
        "data_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContractReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RunReference"
          },
          "title": "Run Refs",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/DiagnosticScope"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "phase": {
          "enum": [
            "preflight",
            "post_run",
            "partial_run"
          ],
          "title": "Phase",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/DiagnosticProvenance"
        }
      },
      "required": [
        "task_ref",
        "plan_ref",
        "no_plan_reason",
        "data_ref",
        "contract_ref",
        "scope",
        "fingerprint",
        "phase",
        "provenance"
      ],
      "title": "DiagnosticContext",
      "type": "object"
    },
    "DiagnosticProvenance": {
      "additionalProperties": false,
      "properties": {
        "recorded_execution_source_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recorded Execution Source Sha"
        },
        "diagnostic_source_sha": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Diagnostic Source Sha",
          "type": "string"
        },
        "reading_mode": {
          "enum": [
            "preflight",
            "historical_read_only",
            "current_execution"
          ],
          "title": "Reading Mode",
          "type": "string"
        }
      },
      "required": [
        "recorded_execution_source_sha",
        "diagnostic_source_sha",
        "reading_mode"
      ],
      "title": "DiagnosticProvenance",
      "type": "object"
    },
    "DiagnosticScope": {
      "additionalProperties": false,
      "properties": {
        "analysis_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Analysis Unit"
        },
        "outcome_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outcome Field"
        },
        "metric_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metric Label"
        },
        "statistic_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Statistic Type"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "observation_window": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observation Window"
        },
        "group_labels": {
          "items": {
            "type": "string"
          },
          "title": "Group Labels",
          "type": "array"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numerator"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator"
        },
        "aggregation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aggregation"
        }
      },
      "required": [
        "analysis_unit",
        "outcome_field",
        "metric_label",
        "statistic_type",
        "unit",
        "observation_window",
        "group_labels",
        "numerator",
        "denominator",
        "aggregation"
      ],
      "title": "DiagnosticScope",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "enum": [
            "data_contract",
            "source_record",
            "step_evidence",
            "run_bundle",
            "validation_observation"
          ],
          "title": "Artifact Kind",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha",
          "type": "string"
        },
        "json_pointer": {
          "default": "",
          "pattern": "^(?:/.*)?$",
          "title": "Json Pointer",
          "type": "string"
        },
        "availability": {
          "const": "valid",
          "default": "valid",
          "title": "Availability",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "sha"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "FindingSource": {
      "additionalProperties": false,
      "properties": {
        "mechanism": {
          "enum": [
            "deterministic_rule",
            "engine_adapter",
            "declaration_record_check"
          ],
          "title": "Mechanism",
          "type": "string"
        },
        "origin": {
          "enum": [
            "program_fact",
            "human_declaration",
            "mixed"
          ],
          "title": "Origin",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        }
      },
      "required": [
        "mechanism",
        "origin",
        "generator_version"
      ],
      "title": "FindingSource",
      "type": "object"
    },
    "Impact": {
      "additionalProperties": false,
      "properties": {
        "claim_effect": {
          "enum": [
            "unchanged",
            "conditional_causal_only",
            "show_limitation",
            "hide_integrated_estimate"
          ],
          "title": "Claim Effect",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "execution_authority": {
          "const": "original_service_only",
          "default": "original_service_only",
          "title": "Execution Authority",
          "type": "string"
        }
      },
      "required": [
        "claim_effect",
        "explanation"
      ],
      "title": "Impact",
      "type": "object"
    },
    "PlanReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "sha": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha"
      ],
      "title": "PlanReference",
      "type": "object"
    },
    "RuleReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "PD-01",
            "PD-02",
            "PD-06",
            "PD-07",
            "PD-09",
            "PD-14"
          ],
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "pack": {
          "title": "Pack",
          "type": "string"
        },
        "check_method": {
          "title": "Check Method",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "pack",
        "check_method"
      ],
      "title": "RuleReference",
      "type": "object"
    },
    "RunReference": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "exploration",
            "research"
          ],
          "title": "Kind",
          "type": "string"
        },
        "plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "result_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "kind",
        "plan_id",
        "result_fingerprint"
      ],
      "title": "RunReference",
      "type": "object"
    },
    "Severity": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "critical",
            "major",
            "moderate",
            "information"
          ],
          "title": "Level",
          "type": "string"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "level",
        "policy_id",
        "reason_code"
      ],
      "title": "Severity",
      "type": "object"
    },
    "TaskReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "automation_v2",
            "research_session"
          ],
          "title": "Kind",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task_id",
        "session_id"
      ],
      "title": "TaskReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "diagnostic-finding-v1.1",
      "default": "diagnostic-finding-v1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "assessment_id": {
      "title": "Assessment Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/DiagnosticContext"
    },
    "rule": {
      "$ref": "#/$defs/RuleReference"
    },
    "diagnostic_type": {
      "enum": [
        "binding",
        "design",
        "metric",
        "execution"
      ],
      "title": "Diagnostic Type",
      "type": "string"
    },
    "applicability": {
      "default": "applicable",
      "enum": [
        "applicable",
        "not_applicable",
        "unknown"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "check_performed": {
      "title": "Check Performed",
      "type": "boolean"
    },
    "status": {
      "enum": [
        "verified",
        "issue",
        "unknown",
        "not_applicable",
        "not_checked"
      ],
      "title": "Status",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/CheckResult"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "impact": {
      "$ref": "#/$defs/Impact"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "human_confirmation_required": {
      "title": "Human Confirmation Required",
      "type": "boolean"
    },
    "eligible_action_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Eligible Action Ids",
      "type": "array"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/FindingSource"
    }
  },
  "required": [
    "finding_id",
    "assessment_id",
    "context",
    "rule",
    "diagnostic_type",
    "check_performed",
    "status",
    "result",
    "evidence_refs",
    "impact",
    "severity",
    "human_confirmation_required",
    "generated_at",
    "source"
  ],
  "title": "DiagnosticFinding",
  "type": "object"
}
